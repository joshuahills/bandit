<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Bandit</RootNamespace>

    <!-- AOT trim feature switches: drop subsystems we don't use so the trimmer
         can prune their dependencies. Smaller binary + less constant startup
         work. None of these affect the .NET tool path (managed JIT). -->
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>

    <!-- AOT and .NET tool packing are mutually exclusive — pack overrides AOT. -->
    <PublishAot Condition="'$(PackAsTool)' != 'true'">true</PublishAot>
    <RuntimeIdentifier Condition="'$(PackAsTool)' != 'true'">win-x64</RuntimeIdentifier>

    <!-- .NET tool metadata (only used when PackAsTool=true). -->
    <ToolCommandName>bandit</ToolCommandName>
    <PackageId>Bandit.Cli</PackageId>
    <Authors>joshuahills</Authors>
    <Company>joshuahills</Company>
    <Description>btop-style network monitor TUI for Windows.</Description>
    <PackageTags>tui;network;monitor;bandwidth;windows</PackageTags>
    <RepositoryUrl>https://github.com/joshuahills/bandit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/joshuahills/bandit</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Terminal.Gui's ConfigurationManager runs in a module initializer and
         uses reflection-based deep cloning on Scheme/Theme types. Trimming
         strips their constructors and the app crashes before Main runs.
         Keeping the assembly intact is the supported fix per TG v2's
         IL2026/IL2090 warnings during AOT publish. -->
    <TrimmerRootAssembly Include="Terminal.Gui" />
  </ItemGroup>

  <!-- Bake the build version into a const string so runtime '-v' lookups
       don't need reflection (which is brittle under AOT trimming). -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <BuildInfoFilePath>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFilePath>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLines Include="namespace Bandit%3B" />
      <_BuildInfoLines Include="internal static class BuildInfo" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    public const string Version = %22$(Version)%22%3B" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFilePath)" Lines="@(_BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFilePath)" KeepDuplicates="false" />
      <FileWrites Include="$(BuildInfoFilePath)" />
    </ItemGroup>
  </Target>

</Project>
